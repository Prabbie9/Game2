{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true, "noImplicitAny": false, "skipLibCheck": true, "resolveJsonModule": true, "isolatedModules": true, "noEmit": true,
    "types": ["vite/client"], "allowImportingTsExtensions": false
  },
  "include": ["src"]
}
